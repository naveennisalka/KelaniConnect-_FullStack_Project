# ==========================================
# Backend Environment Configuration Template
# Copy this file to .env and adjust values for your environment
# ==========================================

# Spring Boot server
SERVER_PORT=8080

# MongoDB Atlas: replace the username, password, and cluster host with your values.
# URL-encode special characters in the database password.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@kelanimedia.18mvfzl.mongodb.net/kelaniMedia?retryWrites=true&w=majority
MONGODB_DATABASE=kelaniMedia

# Generate a private random secret of at least 32 bytes for local use.
JWT_SECRET=replace-this-with-a-private-random-secret-at-least-32-bytes

# JWT Token Expiration in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION=86400000

# CORS Allowed Origins (comma-separated if multiple)
CORS_ALLOWED_ORIGINS=http://localhost:5173
