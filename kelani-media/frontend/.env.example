# ==========================================
# Frontend Environment Configuration Template
# Copy this file to .env and adjust values for your environment
# ==========================================

# Port for Vite dev server
VITE_PORT=5173

# Target backend URL for proxying API requests during development
VITE_BACKEND_URL=http://localhost:8080

# Base API URL prefix
# Leave empty to use Vite proxy ('/api/auth') during local development
# Set to full backend URL (e.g. https://api.yourdomain.com) if connecting directly
VITE_API_BASE_URL=
