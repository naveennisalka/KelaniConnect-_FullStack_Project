# ==========================================
# KelaniConnect Full-Stack Environment Template
# Copy this file to .env and adjust values for your environment
# ==========================================

# --- Backend Configuration (Spring Boot) ---
# Server Port
SERVER_PORT=8080

# MongoDB Connection String
# Local: mongodb://localhost:27017/kelani_connect
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/kelani_connect?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/kelani_connect

# JWT Secret Key (HMAC-SHA requires at least 256 bits / 32 bytes)
JWT_SECRET=YourSuperSecretKeyHereReplaceWithAtLeast32BytesString

# JWT Token Expiration in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION=86400000

# CORS Allowed Origins (comma-separated if multiple)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend Configuration (Vite + React) ---
# Frontend Dev Server Port
VITE_PORT=5173

# Backend proxy target for Vite dev server
VITE_BACKEND_URL=http://localhost:8080

# Base API URL prefix (leave empty to use Vite proxy '/api/auth')
VITE_API_BASE_URL=
